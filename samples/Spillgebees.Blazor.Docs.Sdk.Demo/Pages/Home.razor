@page "/"

<p class="docs-eyebrow">Spillgebees open source</p>
<h1 class="docs-title">Blazor.Docs.Sdk</h1>
<p class="docs-lede">
    Everything you need to build and deploy documentation sites for your Blazor
    component libraries: shell, search, live examples, and a generated API reference.
</p>

<div class="docs-meta-row">
    <span class="docs-chip">MIT licensed</span>
    <span class="docs-chip"><code>net10.0</code></span>
    <span class="docs-chip">Razor Class Library</span>
</div>

<CodeBlock Files="@_install" Language="terminal" />

<h2 id="whats-included">What&rsquo;s included</h2>

<ul>
    <li><strong>Shell layout</strong>: top bar, sidebar, mobile drawer, on-this-page rail, footer.</li>
    <li><strong>Command palette</strong>: <kbd class="docs-kbd">Ctrl K</kbd> search over pages and API types.</li>
    <li><strong>Live examples</strong>: components rendered next to their build-time extracted source.</li>
    <li><strong>API reference</strong>: generated from Roslyn manifests plus your XML doc comments.</li>
    <li><strong>Theming</strong>: three built-in themes, plus a documented token contract for your own.</li>
</ul>

<div class="docs-callout">
    <DocIcon Name="@DocIconName.Spark" />
    <div class="docs-callout-body">
        <p><strong>Try the theme picker.</strong> The selector in the top bar switches between the
        <code>refined</code>, <code>terminal</code> and <code>glory-to-mankind</code> built-ins. All three are the same markup; only
        design tokens differ.</p>
    </div>
</div>

<h2 id="get-started">Get started</h2>

<p>Add the package reference, then wrap your layout in <code>DocSite</code>.</p>

<CodeBlock Files="@_layout" Language="razor" />

@code {
    private static readonly Dictionary<string, string> _install = new()
    {
        ["terminal"] = "dotnet add package Spillgebees.Blazor.Docs.Sdk",
    };

    private static readonly Dictionary<string, string> _layout = new()
    {
        ["MainLayout.razor"] = """
            @inherits LayoutComponentBase

            <DocSite ProjectName="Your.Library"
                     LogoEmoji="🍓"
                     GitHubUrl="https://github.com/Spillgebees/Your.Library"
                     Navigation="@Navigation"
                     Theme="@DocsTheme.Refined">
                @Body
            </DocSite>

            @code {
                private static readonly NavSection[] Navigation =
                [
                    new("Getting Started", [new NavPage("Home", "")]),
                    // any type from your library; its ProjectReference needs DocsApi="true"
                    NavSection.Collapsed("API Reference", ApiReferenceNav.Generate<MyComponent>()),
                ];
            }
            """,
    };
}
