@inherits LayoutComponentBase

@* The demo enables the theme picker so every built-in theme is switchable at
   runtime. A real docs site would usually pin a single theme instead. *@
<DocSite ProjectName="Blazor.Docs.Sdk"
         LogoEmoji="🍓"
         GitHubUrl="https://github.com/Spillgebees/Blazor.Docs.Sdk"
         Navigation="@Navigation"
         Theme="@DocsTheme.Refined"
         ShowThemePicker="true">
    @Body
</DocSite>

@code {
    private static readonly NavSection[] Navigation =
    [
        new("Getting Started", [
            new NavPage("Home", ""),
            new NavPage("Installation", "installation"),
        ]),
        new("Components", [
            new NavPage("DocSite", "components/doc-site"),
            new NavPage("ExampleView", "components/example-view"),
            new NavPage("CodeBlock", "components/code-block"),
            new NavPage("ApiDoc", "components/api-doc"),
            new NavPage("ThemeToggle", "components/theme-toggle"),
        ]),
        // generated and long, so it starts collapsed and is reachable via search
        NavSection.Collapsed("API Reference", ApiReferenceNav.Generate<DocSite>()),
    ];
}
