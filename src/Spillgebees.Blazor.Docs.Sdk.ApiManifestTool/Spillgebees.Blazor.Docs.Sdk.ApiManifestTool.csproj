<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../General.targets" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- the tool never shows compiler diagnostics, so Roslyn's translated resources are dead weight in the package -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- the targets run the tool with `dotnet <dll>`, so the native launcher is never used -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Spillgebees.Blazor.Docs.Sdk\Build\ApiManifest.cs" Link="Build\ApiManifest.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="All" />
  </ItemGroup>
</Project>
