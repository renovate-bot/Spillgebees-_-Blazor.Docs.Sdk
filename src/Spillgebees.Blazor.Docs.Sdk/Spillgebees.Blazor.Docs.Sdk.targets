<Project>
  <!--
    Spillgebees.Blazor.Docs.Sdk build-time targets.
    Packed into build/ (not buildTransitive/) so they only run in projects
    that directly reference the SDK package.

    Both targets run BeforeTargets="PrepareResourceNames;AssignTargetPaths" so
    dynamically added EmbeddedResource items are included before resource name
    snapshotting and still execute early in the item pipeline.

    Two targets:
      1. DocsSdk_ExtractSources: scans .razor files for ExampleView<TComponent>
         references, finds matching source files in referenced projects, and
         embeds them as EmbeddedResource with LogicalName SourceEmbed:{FullTypeName}:{FileName}.
      2. DocsSdk_GenerateApiManifest: runs a Roslyn build-time tool on the built
         assemblies of ProjectReference items opted in with DocsApi="true", then
         embeds the generated JSON manifests as ApiManifest:{AssemblyName}. The
         tool only runs when its inputs change.
  -->

  <!-- ================================================================== -->
  <!-- Source Extraction                                                    -->
  <!-- ================================================================== -->
  <UsingTask
    TaskName="DocsSdk_ExtractSourcesTask"
    TaskFactory="RoslynCodeTaskFactory"
    AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll"
  >
    <ParameterGroup>
      <RazorFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <ReferencedProjectDirs ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="false" />
      <ProjectDir ParameterType="System.String" Required="true" />
      <RootNamespace ParameterType="System.String" Required="true" />
      <IntermediateDir ParameterType="System.String" Required="true" />
      <EmbeddedSources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
var tComponentRe = new Regex(@"TComponent=""(\w+)""");
var additionalSourcesRe = new Regex(@"AdditionalSources=""@\((.*?)\)""");
var typeOfRe = new Regex(@"typeof\(([\w.]+)\)");

// Collect all simple type names referenced from ExampleView usages
var referencedTypes = new HashSet<string>();
if (RazorFiles != null)
{
    foreach (var item in RazorFiles)
    {
        var content = File.ReadAllText(item.GetMetadata("FullPath"));
        foreach (Match m in tComponentRe.Matches(content))
            referencedTypes.Add(m.Groups[1].Value);
        foreach (Match am in additionalSourcesRe.Matches(content))
        {
            var inner = am.Groups[1].Value;
            foreach (Match tm in typeOfRe.Matches(inner))
            {
                var fullTypeName = tm.Groups[1].Value;
                var segments = fullTypeName.Split('.');
                referencedTypes.Add(segments[segments.Length - 1]);
            }
        }
    }
}

if (referencedTypes.Count == 0)
{
    EmbeddedSources = Array.Empty<Microsoft.Build.Framework.ITaskItem>();
    return true;
}

Log.LogMessage(Microsoft.Build.Framework.MessageImportance.Normal,
    "[Docs SDK] Discovered ExampleView types: " + string.Join(", ", referencedTypes));

// Build list of directories to search: the consuming project + referenced project dirs
var searchDirs = new List<string> { ProjectDir };
if (ReferencedProjectDirs != null)
{
    foreach (var d in ReferencedProjectDirs)
    {
        var dir = d.GetMetadata("FullPath");
        if (!string.IsNullOrEmpty(dir))
        {
            var projectFileDir = Path.GetDirectoryName(dir);
            if (!string.IsNullOrEmpty(projectFileDir) && Directory.Exists(projectFileDir))
                searchDirs.Add(projectFileDir);
        }
    }
}

var namespaceRe = new Regex(@"^[ \t]*@namespace\s+([\w.]+)", RegexOptions.Multiline);
var csNamespaceRe = new Regex(@"^[ \t]*namespace\s+([\w.]+)", RegexOptions.Multiline);
// comment stripping intentionally simple, only for namespace-line extraction, not general parsing
var csBlockCommentRe = new Regex(@"/\*.*?\*/", RegexOptions.Singleline);
var csLineCommentRe = new Regex(@"//.*$", RegexOptions.Multiline);
var razorCommentBlockRe = new Regex(@"@\*.*?\*@", RegexOptions.Singleline);
var htmlCommentBlockRe = new Regex(@"<!--.*?-->", RegexOptions.Singleline);
var excludedDirectoryNames = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
{
    "bin",
    "obj",
    "node_modules",
    ".git",
    ".vs"
};

IEnumerable<string> EnumerateFilesByPattern(string rootDir, string searchPattern)
{
    if (string.IsNullOrWhiteSpace(rootDir) || !Directory.Exists(rootDir))
    {
        yield break;
    }

    var pendingDirectories = new Stack<string>();
    pendingDirectories.Push(rootDir);

    while (pendingDirectories.Count > 0)
    {
        var currentDirectory = pendingDirectories.Pop();

        string[] childDirectories;
        try
        {
            childDirectories = Directory.GetDirectories(currentDirectory);
        }
        catch
        {
            continue;
        }

        foreach (var childDirectory in childDirectories)
        {
            var childDirectoryName = Path.GetFileName(childDirectory);
            if (excludedDirectoryNames.Contains(childDirectoryName))
            {
                continue;
            }

            pendingDirectories.Push(childDirectory);
        }

        string[] matchingFiles;
        try
        {
            matchingFiles = Directory.GetFiles(currentDirectory, searchPattern, SearchOption.TopDirectoryOnly);
        }
        catch
        {
            continue;
        }

        foreach (var matchingFile in matchingFiles)
        {
            yield return matchingFile;
        }
    }
}

bool IsGeneratedPureCsCandidate(string filePath)
{
    var fileName = Path.GetFileName(filePath);
    return fileName.EndsWith(".AssemblyInfo.cs", StringComparison.OrdinalIgnoreCase)
        || fileName.EndsWith(".GlobalUsings.g.cs", StringComparison.OrdinalIgnoreCase)
        || fileName.EndsWith(".g.cs", StringComparison.OrdinalIgnoreCase)
        || fileName.EndsWith(".g.i.cs", StringComparison.OrdinalIgnoreCase)
        || fileName.EndsWith(".designer.cs", StringComparison.OrdinalIgnoreCase);
}

var outputDir = Path.Combine(IntermediateDir, "DocsSdk", "sources");
Directory.CreateDirectory(outputDir);

var results = new List<Microsoft.Build.Framework.ITaskItem>();
var embeddedLogicalNames = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
var pureCsFilesBySearchDir = new Dictionary<string, Dictionary<string, List<string>>>(StringComparer.OrdinalIgnoreCase);

foreach (var searchDir in searchDirs)
{
    var filesByName = new Dictionary<string, List<string>>(StringComparer.OrdinalIgnoreCase);
    var pureCsFiles = EnumerateFilesByPattern(searchDir, "*.cs");
    foreach (var pureCsFile in pureCsFiles)
    {
        if (IsGeneratedPureCsCandidate(pureCsFile))
        {
            continue;
        }

        var fileName = Path.GetFileName(pureCsFile);
        if (!filesByName.TryGetValue(fileName, out var matchingFiles))
        {
            matchingFiles = new List<string>();
            filesByName[fileName] = matchingFiles;
        }

        matchingFiles.Add(pureCsFile);
    }

    pureCsFilesBySearchDir[searchDir] = filesByName;
}

foreach (var typeName in referencedTypes)
{
    // Search for matching .razor and .razor.cs files
    foreach (var searchDir in searchDirs)
    {
        var razorFiles = EnumerateFilesByPattern(searchDir, typeName + ".razor");
        foreach (var razorFile in razorFiles)
        {
            // Determine full type name
            var razorContent = File.ReadAllText(razorFile);
            var cleanedRazorContent = htmlCommentBlockRe.Replace(razorCommentBlockRe.Replace(razorContent, ""), "");
            string fullTypeName;
            var nsMatch = namespaceRe.Match(cleanedRazorContent);
            if (nsMatch.Success)
            {
                fullTypeName = nsMatch.Groups[1].Value + "." + typeName;
            }
            else
            {
                // Construct from root namespace + relative path
                var relPath = razorFile.Substring(searchDir.Length).TrimStart(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
                var relDir = Path.GetDirectoryName(relPath) ?? "";
                var nsPart = relDir.Replace(Path.DirectorySeparatorChar, '.').Replace(Path.AltDirectorySeparatorChar, '.');
                fullTypeName = string.IsNullOrEmpty(nsPart) ? RootNamespace + "." + typeName : RootNamespace + "." + nsPart + "." + typeName;
            }

            // Copy .razor file
            var destRazor = Path.Combine(outputDir, fullTypeName + "." + typeName + ".razor");
            var razorLogicalName = "SourceEmbed:" + fullTypeName + ":" + typeName + ".razor";
            if (!embeddedLogicalNames.Add(razorLogicalName))
            {
                continue;
            }

            File.Copy(razorFile, destRazor, true);
            var razorItem = new Microsoft.Build.Utilities.TaskItem(destRazor);
            razorItem.SetMetadata("LogicalName", razorLogicalName);
            results.Add(razorItem);

            Log.LogMessage(Microsoft.Build.Framework.MessageImportance.Normal,
                "[Docs SDK] Embedded source: " + fullTypeName + ":" + typeName + ".razor");

            // Check for .razor.cs file
            var csFile = razorFile + ".cs";
            if (File.Exists(csFile))
            {
                var csLogicalName = "SourceEmbed:" + fullTypeName + ":" + typeName + ".razor.cs";
                if (!embeddedLogicalNames.Add(csLogicalName))
                {
                    continue;
                }

                var destCs = Path.Combine(outputDir, fullTypeName + "." + typeName + ".razor.cs");
                File.Copy(csFile, destCs, true);
                var csItem = new Microsoft.Build.Utilities.TaskItem(destCs);
                csItem.SetMetadata("LogicalName", csLogicalName);
                results.Add(csItem);

                Log.LogMessage(Microsoft.Build.Framework.MessageImportance.Normal,
                    "[Docs SDK] Embedded source: " + fullTypeName + ":" + typeName + ".razor.cs");
            }

        }

        // Check for pure .cs source file with matching type name
        var pureCsFiles = new List<string>();
        if (pureCsFilesBySearchDir.TryGetValue(searchDir, out var filesByName))
        {
            if (filesByName.TryGetValue(typeName + ".cs", out var matchingFiles))
            {
                pureCsFiles = matchingFiles;
            }
        }

        foreach (var pureCsFile in pureCsFiles)
        {
            var csContent = File.ReadAllText(pureCsFile);
            var cleanedCsContent = csLineCommentRe.Replace(csBlockCommentRe.Replace(csContent, ""), "");
            string fullCsTypeName;
            var csNsMatch = csNamespaceRe.Match(cleanedCsContent);
            if (csNsMatch.Success)
            {
                fullCsTypeName = csNsMatch.Groups[1].Value + "." + typeName;
            }
            else
            {
                var relCsPath = pureCsFile.Substring(searchDir.Length).TrimStart(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
                var relCsDir = Path.GetDirectoryName(relCsPath) ?? "";
                var nsPart = relCsDir.Replace(Path.DirectorySeparatorChar, '.').Replace(Path.AltDirectorySeparatorChar, '.');
                fullCsTypeName = string.IsNullOrEmpty(nsPart) ? RootNamespace + "." + typeName : RootNamespace + "." + nsPart + "." + typeName;
            }

            var destPureCs = Path.Combine(outputDir, fullCsTypeName + "." + typeName + ".cs");
            var pureCsLogicalName = "SourceEmbed:" + fullCsTypeName + ":" + typeName + ".cs";
            if (!embeddedLogicalNames.Add(pureCsLogicalName))
            {
                continue;
            }

            File.Copy(pureCsFile, destPureCs, true);

            var pureCsItem = new Microsoft.Build.Utilities.TaskItem(destPureCs);
            pureCsItem.SetMetadata("LogicalName", pureCsLogicalName);
            results.Add(pureCsItem);

            Log.LogMessage(Microsoft.Build.Framework.MessageImportance.Normal,
                "[Docs SDK] Embedded source: " + fullCsTypeName + ":" + typeName + ".cs");
        }
    }
}

EmbeddedSources = results.ToArray();
      ]]>
      </Code>
    </Task>
  </UsingTask>

  <Target
    Name="DocsSdk_ExtractSources"
    BeforeTargets="PrepareResourceNames;AssignTargetPaths"
    DependsOnTargets="ResolveProjectReferences"
  >
    <ItemGroup>
      <_DocsSdk_RazorFiles Include="$(MSBuildProjectDirectory)/**/*.razor" />
      <_DocsSdk_ReferencedProjectDirs Include="@(_MSBuildProjectReferenceExistent)" />
    </ItemGroup>

    <DocsSdk_ExtractSourcesTask
      RazorFiles="@(_DocsSdk_RazorFiles)"
      ReferencedProjectDirs="@(_DocsSdk_ReferencedProjectDirs)"
      ProjectDir="$(MSBuildProjectDirectory)"
      RootNamespace="$(RootNamespace)"
      IntermediateDir="$(BaseIntermediateOutputPath)"
    >
      <Output TaskParameter="EmbeddedSources" ItemName="_DocsSdk_EmbeddedSources" />
    </DocsSdk_ExtractSourcesTask>

    <ItemGroup>
      <EmbeddedResource Include="@(_DocsSdk_EmbeddedSources)" />
    </ItemGroup>
  </Target>

  <!-- ================================================================== -->
  <!-- API Manifest Generation                                             -->
  <!-- ================================================================== -->
  <Target Name="_DocsSdk_ResolveApiManifestInputs" DependsOnTargets="ResolveReferences">
    <PropertyGroup>
      <DocsSdk_ToolTfm Condition="'$(DocsSdk_ToolTfm)' == ''">net10.0</DocsSdk_ToolTfm>
      <_DocsSdk_ApiManifestIntermediateDir>$(IntermediateOutputPath)DocsSdk/</_DocsSdk_ApiManifestIntermediateDir>
      <_DocsSdk_ApiManifestReferencesFile>$(_DocsSdk_ApiManifestIntermediateDir)api-manifest.references</_DocsSdk_ApiManifestReferencesFile>
      <_DocsSdk_ApiManifestStampFile>$(_DocsSdk_ApiManifestIntermediateDir)api-manifest.stamp</_DocsSdk_ApiManifestStampFile>
      <_DocsSdk_PackagedApiManifestTool>$(MSBuildThisFileDirectory)tools/api-manifest/Spillgebees.Blazor.Docs.Sdk.ApiManifestTool.dll</_DocsSdk_PackagedApiManifestTool>
      <_DocsSdk_SourceApiManifestTool>$(MSBuildThisFileDirectory)../Spillgebees.Blazor.Docs.Sdk.ApiManifestTool/bin/$(Configuration)/$(DocsSdk_ToolTfm)/Spillgebees.Blazor.Docs.Sdk.ApiManifestTool.dll</_DocsSdk_SourceApiManifestTool>
      <_DocsSdk_SourceApiManifestToolProject>$(MSBuildThisFileDirectory)../Spillgebees.Blazor.Docs.Sdk.ApiManifestTool/Spillgebees.Blazor.Docs.Sdk.ApiManifestTool.csproj</_DocsSdk_SourceApiManifestToolProject>
      <_DocsSdk_ApiManifestTool Condition="Exists('$(_DocsSdk_PackagedApiManifestTool)')"
        >$(_DocsSdk_PackagedApiManifestTool)</_DocsSdk_ApiManifestTool>
      <_DocsSdk_ApiManifestTool
        Condition="'$(_DocsSdk_ApiManifestTool)' == '' and Exists('$(_DocsSdk_SourceApiManifestTool)')"
        >$(_DocsSdk_SourceApiManifestTool)</_DocsSdk_ApiManifestTool>
    </PropertyGroup>

    <!--
      The manifest is read from the assembly the referenced project already built, so the
      project is never built a second time. Its XML documentation file supplies the summaries.
    -->
    <ItemGroup>
      <_DocsSdk_ApiAssembly
        Include="@(_ResolvedProjectReferencePaths)"
        Condition="'%(_ResolvedProjectReferencePaths.DocsApi)' == 'true'"
      />
      <_DocsSdk_ApiAssembly>
        <DocumentationFile>%(RootDir)%(Directory)%(Filename).xml</DocumentationFile>
        <ManifestFile>$(_DocsSdk_ApiManifestIntermediateDir)manifests/%(Filename).json</ManifestFile>
      </_DocsSdk_ApiAssembly>
    </ItemGroup>

    <Error
      Code="DOCSSDK002"
      Text="[Docs SDK] '%(_DocsSdk_ApiAssembly.MSBuildSourceProjectFile)' has not been built, so its API manifest can't be generated. Expected '%(_DocsSdk_ApiAssembly.FullPath)'."
      Condition="'%(_DocsSdk_ApiAssembly.Identity)' != '' and !Exists('%(_DocsSdk_ApiAssembly.FullPath)')"
    />

    <Warning
      Code="DOCSSDK001"
      Text="[Docs SDK] '%(_DocsSdk_ApiAssembly.MSBuildSourceProjectFile)' has no XML documentation file at '%(_DocsSdk_ApiAssembly.DocumentationFile)', so its API reference will have no summaries. Set GenerateDocumentationFile to true in that project."
      Condition="'%(_DocsSdk_ApiAssembly.Identity)' != '' and !Exists('%(_DocsSdk_ApiAssembly.DocumentationFile)')"
    />

    <Exec
      Command="dotnet build &quot;$(_DocsSdk_SourceApiManifestToolProject)&quot; -c &quot;$(Configuration)&quot; -nologo"
      Condition="'@(_DocsSdk_ApiAssembly)' != '' and '$(_DocsSdk_ApiManifestTool)' == '' and Exists('$(_DocsSdk_SourceApiManifestToolProject)')"
    />

    <PropertyGroup Condition="'@(_DocsSdk_ApiAssembly)' != '' and '$(_DocsSdk_ApiManifestTool)' == '' and Exists('$(_DocsSdk_SourceApiManifestTool)')">
      <_DocsSdk_ApiManifestTool>$(_DocsSdk_SourceApiManifestTool)</_DocsSdk_ApiManifestTool>
    </PropertyGroup>

    <Error
      Text="[Docs SDK] Could not locate the API manifest tool."
      Condition="'@(_DocsSdk_ApiAssembly)' != '' and '$(_DocsSdk_ApiManifestTool)' == ''"
    />

    <WriteLinesToFile
      File="$(_DocsSdk_ApiManifestReferencesFile)"
      Lines="@(ReferencePath->'%(FullPath)')"
      Overwrite="true"
      WriteOnlyWhenDifferent="true"
      Condition="'@(_DocsSdk_ApiAssembly)' != ''"
    />

    <!-- a deleted manifest is regenerated even when the inputs are older than the stamp -->
    <Delete
      Files="$(_DocsSdk_ApiManifestStampFile)"
      Condition="'%(_DocsSdk_ApiAssembly.Identity)' != '' and !Exists('%(_DocsSdk_ApiAssembly.ManifestFile)')"
    />

    <!--
      A missing XML documentation file stays in the inputs on purpose: MSBuild treats a missing input
      as out of date, so deleting the file regenerates the manifest without its summaries.
    -->
    <ItemGroup Condition="'@(_DocsSdk_ApiAssembly)' != ''">
      <_DocsSdk_ApiManifestInput Include="@(_DocsSdk_ApiAssembly);%(_DocsSdk_ApiAssembly.DocumentationFile)" />
      <_DocsSdk_ApiManifestInput Include="@(ReferencePath)" />
      <_DocsSdk_ApiManifestInput Include="$(_DocsSdk_ApiManifestReferencesFile);$(_DocsSdk_ApiManifestTool);$(MSBuildThisFileFullPath)" />
    </ItemGroup>
  </Target>

  <Target
    Name="_DocsSdk_GenerateApiManifestCore"
    Condition="'@(_DocsSdk_ApiAssembly)' != ''"
    Inputs="@(_DocsSdk_ApiManifestInput)"
    Outputs="$(_DocsSdk_ApiManifestStampFile)"
  >
    <!-- the tool leaves a manifest untouched when its content is unchanged -->
    <Exec Command="dotnet &quot;$(_DocsSdk_ApiManifestTool)&quot; --assembly &quot;%(_DocsSdk_ApiAssembly.FullPath)&quot; --documentation &quot;%(_DocsSdk_ApiAssembly.DocumentationFile)&quot; --references &quot;$(_DocsSdk_ApiManifestReferencesFile)&quot; --output &quot;%(_DocsSdk_ApiAssembly.ManifestFile)&quot;" />

    <Touch Files="$(_DocsSdk_ApiManifestStampFile)" AlwaysCreate="true" />
  </Target>

  <Target
    Name="DocsSdk_GenerateApiManifest"
    BeforeTargets="PrepareResourceNames;AssignTargetPaths"
    DependsOnTargets="_DocsSdk_ResolveApiManifestInputs;_DocsSdk_GenerateApiManifestCore"
    Condition="'$(DesignTimeBuild)' != 'true'"
  >
    <!-- design-time builds can run before the referenced projects have been built -->
    <ItemGroup Condition="'@(_DocsSdk_ApiAssembly)' != ''">
      <_DocsSdk_ApiManifestFile Include="%(_DocsSdk_ApiAssembly.ManifestFile)" />
      <_DocsSdk_ApiManifestFile>
        <LogicalName>ApiManifest:%(Filename)</LogicalName>
      </_DocsSdk_ApiManifestFile>
      <EmbeddedResource Include="@(_DocsSdk_ApiManifestFile)" />
      <FileWrites Include="@(_DocsSdk_ApiManifestFile);$(_DocsSdk_ApiManifestReferencesFile);$(_DocsSdk_ApiManifestStampFile)" />
    </ItemGroup>
  </Target>
</Project>
