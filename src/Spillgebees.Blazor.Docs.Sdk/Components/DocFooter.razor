@namespace Spillgebees.Blazor.Docs.Sdk

@* Rendered at the bottom of the sidebar by DocSite so it is always visible on
   desktop, rather than only after scrolling to the end of a page. *@
@* Two deliberate rows rather than a wrapping single line: at sidebar width the
   three parts cannot share a row, and letting them wrap left a dangling
   separator at the end of the first line. *@
<footer class="docs-footer">
    <span class="docs-footer-row">
        made by
        <a href="@AuthorUrl" target="_blank" rel="noopener noreferrer">@AuthorName</a>
        with <span role="img" aria-label="strawberry">🍓</span>
    </span>

    <span class="docs-footer-row">
        <span>@License</span>

        @if (SafeProjectUrl is not null)
        {
            <span class="docs-footer-sep" aria-hidden="true">·</span>
            <a class="docs-footer-mark"
               href="@SafeProjectUrl"
               target="_blank"
               rel="noopener noreferrer"
               aria-label="Project on GitHub"
               title="Project on GitHub">
                <DocIcon Name="@DocIconName.GitHub" />
            </a>
        }
    </span>
</footer>

@code {
    /// <summary>
    /// The project repository URL, linked from the GitHub mark.
    /// </summary>
    [Parameter, EditorRequired]
    public string GitHubUrl { get; set; } = default!;

    /// <summary>The author name shown in the attribution.</summary>
    [Parameter]
    public string AuthorName { get; set; } = "igotinfected";

    /// <summary>The author's profile URL, linked from their name.</summary>
    [Parameter]
    public string AuthorUrl { get; set; } = "https://github.com/igotinfected";

    /// <summary>The licence label.</summary>
    [Parameter]
    public string License { get; set; } = "MIT";

    private string? SafeProjectUrl =>
        Uri.TryCreate(GitHubUrl, UriKind.Absolute, out var uri)
        && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps)
            ? uri.ToString()
            : null;
}
