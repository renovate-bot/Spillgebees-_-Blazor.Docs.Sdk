@namespace Spillgebees.Blazor.Docs.Sdk
@using Microsoft.JSInterop
@inject IJSRuntime JS

<button type="button"
        class="docs-icon-btn docs-theme-toggle"
        @onclick="@CycleAsync"
        title="@Title"
        aria-label="@Title">
    <DocIcon Name="@Icon" />
</button>

@code {
    /// <summary>
    /// Raised after the visitor changes the colour scheme preference.
    /// </summary>
    [Parameter]
    public EventCallback<DocsColorScheme> OnSchemeChanged { get; set; }

    // Bumped by DocSite whenever the theme or scheme changes anywhere, so a
    // currently hidden copy re-reads the applied value.
    [CascadingParameter(Name = DocSite.ChromeRevisionName)]
    private int Revision { get; set; }

    private DocsColorScheme _scheme = DocsColorScheme.System;
    private int _lastRevision;

    private DocIconName Icon =>
        _scheme switch
        {
            DocsColorScheme.Light => DocIconName.Sun,
            DocsColorScheme.Dark => DocIconName.Moon,
            _ => DocIconName.Monitor,
        };

    private string Title =>
        _scheme switch
        {
            DocsColorScheme.Light => "Colour scheme: light",
            DocsColorScheme.Dark => "Colour scheme: dark",
            _ => "Colour scheme: follow system",
        };

    // DocSite renders a second copy inside the mobile drawer. A parent
    // re-render alone does not reliably re-run this hook on the sibling, so the
    // shell bumps Revision and we re-read on that.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender && Revision == _lastRevision)
        {
            return;
        }

        _lastRevision = Revision;

        var stored = await GetSchemeAsync();
        if (stored != _scheme)
        {
            _scheme = stored;
            StateHasChanged();
        }
    }

    private async Task CycleAsync()
    {
        _scheme = await CycleSchemeAsync();
        StateHasChanged();
        await OnSchemeChanged.InvokeAsync(_scheme);
    }

    private async Task<DocsColorScheme> GetSchemeAsync()
    {
        try
        {
            var value = await JS.InvokeAsync<string>("Spillgebees.DocsSdk.getSchemePreference");
            return DocsColorSchemeExtensions.ParseColorScheme(value);
        }
        catch (Exception exception) when (IsInteropUnavailable(exception))
        {
            return DocsColorScheme.System;
        }
    }

    private async Task<DocsColorScheme> CycleSchemeAsync()
    {
        try
        {
            var value = await JS.InvokeAsync<string>("Spillgebees.DocsSdk.cycleSchemePreference");
            return DocsColorSchemeExtensions.ParseColorScheme(value);
        }
        catch (Exception exception) when (IsInteropUnavailable(exception))
        {
            // fall back to cycling locally so the control still advances
            return _scheme switch
            {
                DocsColorScheme.System => DocsColorScheme.Light,
                DocsColorScheme.Light => DocsColorScheme.Dark,
                _ => DocsColorScheme.System,
            };
        }
    }

    private static bool IsInteropUnavailable(Exception exception) =>
        exception is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException;
}
