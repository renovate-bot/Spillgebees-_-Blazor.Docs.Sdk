@* Inline icon set. Kept in one component so themes and components share a
   single visual language and consumers can reference icons by name. *@
@namespace Spillgebees.Blazor.Docs.Sdk

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
     stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case DocIconName.Search:
            <circle cx="11" cy="11" r="7" />
            <path d="m20 20-3.5-3.5" />
            break;
        case DocIconName.Menu:
            <path d="M4 7h16M4 12h16M4 17h16" />
            break;
        case DocIconName.Close:
            <path d="M6 6l12 12M18 6L6 18" />
            break;
        case DocIconName.Sun:
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" />
            break;
        case DocIconName.Moon:
            <path d="M21 13a8.5 8.5 0 0 1-10-10 8.5 8.5 0 1 0 10 10Z" />
            break;
        case DocIconName.Monitor:
            <rect x="3" y="4" width="18" height="12" rx="2" />
            <path d="M8 20h8m-4-4v4" />
            break;
        case DocIconName.Copy:
            <rect x="9" y="9" width="11" height="11" rx="2" />
            <path d="M5 15V5a2 2 0 0 1 2-2h10" />
            break;
        case DocIconName.Check:
            <path d="m4 12.5 5 5L20 6.5" />
            break;
        case DocIconName.Link:
            <path d="M10 13a5 5 0 0 0 7 0l2-2a5 5 0 0 0-7-7l-1 1" />
            <path d="M14 11a5 5 0 0 0-7 0l-2 2a5 5 0 0 0 7 7l1-1" />
            break;
        case DocIconName.Chevron:
            <path d="m9 6 6 6-6 6" />
            break;
        case DocIconName.ArrowLeft:
            <path d="M19 12H5m6 6-6-6 6-6" />
            break;
        case DocIconName.ArrowRight:
            <path d="M5 12h14m-6-6 6 6-6 6" />
            break;
        case DocIconName.Eye:
            <path d="M2 12s3.6-6 10-6 10 6 10 6-3.6 6-10 6-10-6-10-6Z" />
            <circle cx="12" cy="12" r="2.5" />
            break;
        case DocIconName.Code:
            <path d="m9 8-5 4 5 4m6-8 5 4-5 4" />
            break;
        case DocIconName.Split:
            @* stacked panes, matching the vertical split the view actually uses *@
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="M3 12h18" />
            break;
        case DocIconName.Book:
            <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H19v15H6.5A2.5 2.5 0 0 0 4 20.5z" />
            <path d="M4 20.5A2.5 2.5 0 0 1 6.5 18H19v3H6.5A2.5 2.5 0 0 1 4 20.5z" />
            break;
        case DocIconName.Cube:
            <path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z" />
            <path d="M4 7.5 12 12l8-4.5M12 12v9" />
            break;
        case DocIconName.Hash:
            <path d="M5 9h14M5 15h14M10 4l-2 16M16 4l-2 16" />
            break;
        case DocIconName.Wrap:
            <path d="M4 6h16M4 18h7" />
            <path d="M4 12h13a3 3 0 0 1 0 6h-3" />
            <path d="m13 15-2 3 2 3" />
            break;
        case DocIconName.Brackets:
            <path d="M9 4H7a2 2 0 0 0-2 2v4l-2 2 2 2v4a2 2 0 0 0 2 2h2" />
            <path d="M15 4h2a2 2 0 0 1 2 2v4l2 2-2 2v4a2 2 0 0 1-2 2h-2" />
            break;
        case DocIconName.Tag:
            <path d="M3 12V5a2 2 0 0 1 2-2h7l9 9-9 9z" />
            <circle cx="7.5" cy="7.5" r="1.2" />
            break;
        case DocIconName.Spark:
            <path d="M12 3l2.2 5.6L20 11l-5.8 2.4L12 19l-2.2-5.6L4 11l5.8-2.4z" />
            break;
        case DocIconName.Palette:
            <path d="M12 3a9 9 0 1 0 0 18 2 2 0 0 0 1.6-3.2 2 2 0 0 1 1.6-3.2H18a3 3 0 0 0 3-3 9 9 0 0 0-9-8.6Z" />
            <circle cx="7.5" cy="12" r="1" fill="currentColor" />
            <circle cx="10" cy="8" r="1" fill="currentColor" />
            <circle cx="14.5" cy="8" r="1" fill="currentColor" />
            break;
        case DocIconName.GitHub:
            <path fill="currentColor" stroke="none" d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z" />
            break;
    }
</svg>

@code {
    /// <summary>
    /// The icon to render.
    /// </summary>
    [Parameter, EditorRequired]
    public DocIconName Name { get; set; }
}
